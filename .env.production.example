# AI-Quantitative Platform - Production Environment Configuration
#
# IMPORTANT: Never commit the actual .env.production file to git
# Use this .env.production.example as a template
# Copy to .env.production and fill in your actual values
#
# Generated: 2026-05-21
# For: Suhas GM (suhasgm@gmail.com)

# ============================================================================
# 🔑 AI/LLM API Keys (Required)
# ============================================================================

# Anthropic Claude API key - used for signal validation and analysis
# Get from: https://console.anthropic.com/
# Format: sk-ant-v0-[long-alphanumeric-string]
ANTHROPIC_API_KEY=sk-ant-v0-YOUR_ACTUAL_KEY_HERE

# Google Gemini API key - fallback AI provider
# Get from: https://aistudio.google.com/app/apikey
# Format: AIzaSy[long-alphanumeric-string]
GEMINI_API_KEY=AIzaSy-YOUR_ACTUAL_KEY_HERE

# ============================================================================
# 🔐 Security Credentials (Generated)
# ============================================================================

# TradingView webhook secret - validates incoming TradingView alerts
# Generate with: openssl rand -base64 32
# This must match the secret you use in your TradingView alert webhook
# Render can auto-generate this if you leave it blank in the dashboard
WEBHOOK_SECRET=QmFzZTY0RW5jb2RlZFN0cmluZzEyMzQ1Njc4OTAx

# ============================================================================
# 🌐 Application Configuration
# ============================================================================

# Environment name for logging and monitoring
ENVIRONMENT=production

# Frontend domain for CORS and redirects
# Example: https://trading-frontend-abcd1234.onrender.com
FRONTEND_URL=https://your-frontend-domain.onrender.com

# CORS origins - restrict to your specific frontend domain
# Comma-separated if multiple origins
CORS_ORIGINS=https://your-frontend-domain.onrender.com,https://yourdomainname.com

# ============================================================================
# 💾 Database Configuration (Auto-provided by Render)
# ============================================================================

# Redis connection string - Render provides this automatically
# Format: redis://username:password@host:port/db
# Leave blank if using Render's managed Redis (auto-configured)
REDIS_URL=redis://render-redis-service:6379

# PostgreSQL (optional, if using managed database)
# Leave blank if using Render's managed Postgres
DATABASE_URL=

# ============================================================================
# 📊 Trading Configuration
# ============================================================================

# Trading mode: 'paper_trading' or 'live_trading'
# Start with 'paper_trading' for 1-2 weeks before switching to 'live_trading'
TRADING_MODE=paper_trading

# Account size in USD - matches your real trading account
ACCOUNT_SIZE=100000

# Risk per trade as percentage (1% = 0.01)
# Recommended: Start with 0.005 (0.5%) for live trading
RISK_PER_TRADE=0.01

# Maximum position size as percentage (5% = 0.05)
MAX_POSITION_SIZE=0.05

# Maximum sector exposure as percentage (20% = 0.20)
MAX_SECTOR_EXPOSURE=0.20

# Maximum total leverage (130% = 1.30)
MAX_TOTAL_LEVERAGE=1.30

# Maximum acceptable drawdown before alerts (20% = 0.20)
MAX_DRAWDOWN_THRESHOLD=0.20

# ============================================================================
# 📈 Signal Processing Configuration
# ============================================================================

# Minimum confidence score to execute (0-10 scale)
MIN_CONFIDENCE_SCORE=6.0

# Minimum hybrid score to execute (0-100 scale)
MIN_HYBRID_SCORE=60

# Maximum age of signal data in seconds (300 = 5 minutes)
MAX_DATA_AGE=300

# RSI overbought threshold (0-100 scale)
RSI_OVERBOUGHT=70

# RSI oversold threshold (0-100 scale)
RSI_OVERSOLD=30

# Minimum volume ratio relative to average (80% = 0.80)
MIN_VOLUME_RATIO=0.80

# ============================================================================
# 🔍 Backtesting Configuration
# ============================================================================

# Trading commission percentage (0.1% = 0.001)
BACKTEST_COMMISSION=0.001

# Slippage allowance percentage (0.05% = 0.0005)
BACKTEST_SLIPPAGE=0.0005

# Lookback period in years for historical data
BACKTEST_LOOKBACK_PERIOD=2

# Walk-forward validation window in trading days (252 = 1 year)
BACKTEST_WALK_FORWARD_WINDOW=252

# ============================================================================
# 📧 Email & Reporting Configuration
# ============================================================================

# Enable automated email reports
ENABLE_EMAIL_REPORTS=true

# Email recipient for daily/weekly/monthly reports
REPORT_EMAIL=suhasgm@gmail.com

# SMTP server configuration (if using custom email)
# Leave empty to use Render's email service
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Daily report time in HH:MM UTC format (09:00 = 9 AM UTC)
DAILY_REPORT_TIME=09:00

# Weekly report day and time (Sunday at 9 AM UTC)
WEEKLY_REPORT_DAY=Sunday
WEEKLY_REPORT_TIME=09:00

# Monthly report day and time (1st of month at 9 AM UTC)
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_TIME=09:00

# ============================================================================
# 📊 Market Data Configuration
# ============================================================================

# Primary data provider: 'yfinance', 'finnhub', 'polygon'
PRIMARY_DATA_PROVIDER=yfinance

# Fallback data providers (comma-separated)
FALLBACK_DATA_PROVIDERS=finnhub,polygon

# Finnhub API key (optional, for US stocks/crypto)
FINNHUB_API_KEY=your-finnhub-key-here

# Polygon.io API key (optional, for advanced data)
POLYGON_API_KEY=your-polygon-key-here

# ============================================================================
# 🔗 Broker Configuration (for live trading)
# ============================================================================

# Broker type: 'alpaca', 'interactive_brokers', 'paper'
# Use 'paper' for simulated trading
# Use 'alpaca' for live trading with Alpaca broker
BROKER_TYPE=paper

# Alpaca API key (leave empty if using paper trading)
ALPACA_API_KEY=

# Alpaca API secret (leave empty if using paper trading)
ALPACA_API_SECRET=

# Alpaca base URL (paper or live)
# Paper: https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================================================
# 🔔 Monitoring & Alerting
# ============================================================================

# Enable system health monitoring
ENABLE_MONITORING=true

# Alert threshold: CPU usage percentage (80 = 80%)
CPU_ALERT_THRESHOLD=80

# Alert threshold: Memory usage percentage
MEMORY_ALERT_THRESHOLD=80

# Alert threshold: Queue job age in seconds (3600 = 1 hour)
QUEUE_ALERT_THRESHOLD=3600

# ============================================================================
# 🔧 Development/Debug Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable detailed logging for debugging
DEBUG_MODE=false

# Enable profiling (may impact performance)
ENABLE_PROFILING=false

# ============================================================================
# ✅ Deployment Checklist
# ============================================================================
#
# Before deploying to production:
# 1. [ ] Fill in all API keys above
# 2. [ ] Generate a secure WEBHOOK_SECRET
# 3. [ ] Set TRADING_MODE to 'paper_trading' initially
# 4. [ ] Update FRONTEND_URL and CORS_ORIGINS
# 5. [ ] Configure email settings
# 6. [ ] Set appropriate risk limits
# 7. [ ] Never commit actual .env.production file
# 8. [ ] Add to Render Dashboard environment variables
# 9. [ ] Test all endpoints before enabling live trading
# 10. [ ] Monitor paper trading for 1-2 weeks before going live
#
# ============================================================================
