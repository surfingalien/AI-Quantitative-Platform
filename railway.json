{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "trading-redis",
      "source": {
        "type": "image",
        "image": "redis:7-alpine"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "variables": {
        "REDIS_PORT": "6379"
      }
    },
    {
      "name": "trading-backend",
      "source": {
        "type": "repo",
        "repo": "https://github.com/surfingalien/AI-Quantitative-Platform",
        "rootDirectory": "backend"
      },
      "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
      "variables": {
        "REDIS_URL": "redis://trading-redis:6379",
        "ANTHROPIC_API_KEY": {
          "description": "Anthropic Claude API key (sk-ant-v0-...)",
          "value": ""
        },
        "GEMINI_API_KEY": {
          "description": "Google Gemini API key (optional)",
          "value": ""
        },
        "WEBHOOK_SECRET": {
          "description": "TradingView webhook secret",
          "value": ""
        },
        "FINNHUB_API_KEY": {
          "description": "Finnhub API key for news ingestion (optional)",
          "value": ""
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:$PORT/health"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    },
    {
      "name": "trading-worker",
      "source": {
        "type": "repo",
        "repo": "https://github.com/surfingalien/AI-Quantitative-Platform",
        "rootDirectory": "backend"
      },
      "buildCommand": "pip install -r requirements.txt",
      "startCommand": "python -u run_worker.py",
      "variables": {
        "REDIS_URL": "redis://trading-redis:6379",
        "ANTHROPIC_API_KEY": {
          "description": "Anthropic Claude API key",
          "value": ""
        },
        "GEMINI_API_KEY": {
          "description": "Google Gemini API key (optional)",
          "value": ""
        }
      }
    },
    {
      "name": "trading-frontend",
      "source": {
        "type": "repo",
        "repo": "https://github.com/surfingalien/AI-Quantitative-Platform",
        "rootDirectory": "frontend"
      },
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm start",
      "variables": {
        "NEXT_PUBLIC_BACKEND_URL": ""
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:3000"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}